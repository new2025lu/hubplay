{
  "name": "hubplay",
  "productName": "HubPlay",
  "version": "1.6.27",
  "description": "HubPlay —— 面向 iptv-hub 的 Windows 桌面 IPTV 播放器（内置 ffmpeg 兜底，Chromium 解不了的源也能播）",
  "author": "lu",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.hubplay.desktop",
    "productName": "HubPlay",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "compression": "normal",
    "extraResources": [
      {
        "from": "vendor-win/ffmpeg-master-latest-win64-gpl-shared/bin",
        "to": "ffmpeg",
        "filter": [
          "**/*",
          "!ffplay.exe"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/new2025lu/hubplay.git"
  },
  "bugs": {
    "url": "https://github.com/new2025lu/hubplay/issues"
  },
  "homepage": "https://github.com/new2025lu/hubplay#readme",
  "keywords": [
    "iptv",
    "iptv-hub",
    "m3u",
    "electron",
    "player",
    "hls",
    "ffmpeg",
    "windows"
  ]
}
